    {
      "name": "Customer containing Minh",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/orders/searchByCustomer?customerName=Minh",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "orders",
            "searchByCustomer"
          ],
          "query": [
            {
              "key": "customerName",
              "value": "Minh"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test(\"Response is array\", () => pm.expect(data).to.be.an(\"array\"));",
              "pm.test(\"4 matching sample orders\", () => { pm.expect(data.length).to.eql(4); data.forEach(o => pm.expect(o.customerName).to.include(\"Minh\")); });"
            ]
          }
        }
      ]
    },
